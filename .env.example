# Copy this file to .env and replace local-only placeholders.
SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development
APP_BASE_URL=https://trustvault-production-e0fd.up.railway.app
DATABASE_URL=postgresql://user:password@localhost:5432/trustvault
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-only-supabase-key
SUPABASE_BUCKET=trustvault-documents
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-trustvault-sender@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=your-trustvault-sender@gmail.com
COOKIE_SECURE=False
TRUST_PROXY=True
SESSION_TIMEOUT_MINUTES=30
# Keep demo seeding disabled unless using an isolated non-production database.
TRUSTVAULT_DEMO_MODE=False
# Optional private file storage path (outside frontend/static).
TRUSTVAULT_STORAGE=

# Optional values required only when explicitly running seed_demo.py in
# an isolated non-production environment. Supply unique values locally.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# DEMO_OWNER_NAME=
# DEMO_OWNER_EMAIL=
# DEMO_OWNER_PASSWORD=
# DEMO_VIEWER_NAME=
# DEMO_VIEWER_EMAIL=
# DEMO_VIEWER_PASSWORD=
