# Copy this file to .env locally and replace every placeholder.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/trustvault
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-trustvault-sender@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=your-trustvault-sender@gmail.com
COOKIE_SECURE=False
TRUST_PROXY=True
SESSION_TIMEOUT_MINUTES=30
# Optional private file storage path (outside frontend/static)
TRUSTVAULT_STORAGE=

# Optional deploy/demo seed account configuration (not actual credentials)
ADMIN_NAME=Demo Administrator
ADMIN_EMAIL=demo-admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
DEMO_OWNER_NAME=Demo Owner
DEMO_OWNER_EMAIL=demo-owner@example.com
DEMO_OWNER_PASSWORD=replace-with-a-strong-owner-password
DEMO_VIEWER_NAME=Demo Viewer
DEMO_VIEWER_EMAIL=demo-viewer@example.com
DEMO_VIEWER_PASSWORD=replace-with-a-strong-viewer-password
